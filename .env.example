# Copy to .env and fill in. Never commit .env (it is ignored by git).
# Only an API key is required for model runs; heuristic runs, the solver and the tests need nothing.

# --- Model endpoint (any OpenAI-compatible API) -------------------------------------------------
# Default: the GWDG SAIA service used in the thesis. Set SAIA_BASE_URL to use another provider,
# e.g. https://openrouter.ai/api/v1 or https://api.groq.com/openai/v1, with that provider's key.
SAIA_API_KEY=
SAIA_BASE_URL=https://chat-ai.academiccloud.de/v1
# Optional comma-separated key pool for rate limits; SAIA_API_KEY is appended automatically.
SAIA_API_KEYS=

# --- Task model (presets in mota/optimizer/model_config.py; --preset overrides these) -----------
MOTA_TASK_MODEL=qwen3.5-397b-a17b
MOTA_TASK_MODE=thinking
THINKING_MAX_TOKENS=32768
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=600
MOTA_EVAL_TEMPERATURE=0.0

# --- Prompt optimisation ------------------------------------------------------------------------
MOTA_REFLECTION_MODEL=qwen3.5-397b-a17b
MOTA_REFLECTION_MAX_TOKENS=8000
GEPA_MAX_CALLS=50

# --- Engine settings: see docs/configuration.md (unset = default) -------------------------------
# CONVERSATION_HISTORY_TURNS=0
# MOTA_ORDER_TWO_SIDED=1
# MOTA_FIGHT_KEY_FLOOD=1
# LOOKAHEAD_DEPTH=3
# MOTA_DISABLE_OVERRIDES=1
# MOTA_BARE_OBS=1
# MOTA_PLAN_STEPS=5
